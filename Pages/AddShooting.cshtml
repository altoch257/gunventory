@page
@model AddShootingModel
@{
    ViewData["Title"] = "Add Shooting Activity";
}

<div class="container text-white">
    <div class="form-group row justify-content-center">
        <div class="col-sm-10 col-md-8 col-lg-6">
            <p class="display-6 mt-5 mb-0">Add Shooting Activity</p>
            <p class="mt-0"><hr class="bg-secondary" /></p>
        </div>
    </div>

    <form method="post" class="form">
        <div class="form-group row justify-content-md-center">
            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <select asp-for="Input.FirearmId" asp-items="Model.Firearms" class="form-control form-control-2">
                    <option value="">[Select Firearm] *</option>
                </select>
                <span asp-validation-for="Input.FirearmId" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <select asp-for="Input.AmmoId" asp-items="Model.Ammunitions" class="form-control form-control-2">
                    <option value="">[Select Ammo] *</option>
                </select>
                <span asp-validation-for="Input.AmmoId" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <select asp-for="Input.ShootingTypeId" asp-items="Model.ShootingTypes" class="form-control form-control-2">
                    <option value="">[Select Shooting Type] *</option>
                </select>
                <span asp-validation-for="Input.ShootingTypeId" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <input asp-for="Input.ShootingDate" class="form-control floating_input" type="date">
                <label asp-for="Input.ShootingDate" class="floating_label" data-content="Shooting Date *">
                    <span class="hidden--visually">Shooting Date</span>
                </label>
                <span asp-validation-for="Input.ShootingDate" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <input asp-for="Input.RoundsFired" class="form-control floating_input" placeholder="Rounds Fired">
                <label asp-for="Input.RoundsFired" class="floating_label" data-content="Rounds Fired *">
                    <span class="hidden--visually">Rounds Fired</span>
                </label>
                <span asp-validation-for="Input.RoundsFired" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <div class="form-check">
                    <input asp-for="Input.Subtract" class="form-check-input" type="checkbox">
                    <label asp-for="Input.Subtract" class="form-check-label">Subtract from Ammo Inventory?</label>
                </div>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <textarea asp-for="Input.Details" class="form-control form-control-2" rows="5" placeholder="Details"></textarea>
                <span asp-validation-for="Input.Details" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row justify-content-center">
            <div class="col-sm-10 col-md-8 col-lg-7">
                <button type="submit" class="btn btn-primary btn-block w-100">Submit</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
