@page
@model AddFirearmModel
@{
    ViewData["Title"] = "Add Firearm";
}

<div class="container">
    <div class="form-group row justify-content-center">
        <div class="col-sm-10 col-md-8 col-lg-6">
            <p class="display-6 mt-5 mb-0 text-white">Add Firearm</p>
            <p class="mt-0"><hr class="bg-secondary" /></p>
        </div>
    </div>

    <form method="post" class="form" enctype="multipart/form-data">
        <div class="form-group row justify-content-md-center text-white">
            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <input asp-for="Input.Manufacturer" class="form-control floating_input" placeholder="Manufacturer" autofocus>
                <label asp-for="Input.Manufacturer" class="floating_label" data-content="Manufacturer *">
                    <span class="hidden--visually">Manufacturer</span>
                </label>
                <span asp-validation-for="Input.Manufacturer" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <input asp-for="Input.Model" class="form-control floating_input" placeholder="Model">
                <label asp-for="Input.Model" class="floating_label" data-content="Model *">
                    <span class="hidden--visually">Model</span>
                </label>
                <span asp-validation-for="Input.Model" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <select asp-for="Input.GunTypeId" asp-items="Model.GunTypes" class="form-control form-control-2">
                    <option value="">[Select Gun Type] *</option>
                </select>
                <span asp-validation-for="Input.GunTypeId" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <select asp-for="Input.CaliberId" asp-items="Model.Calibers" class="form-control form-control-2">
                    <option value="">[Select Caliber] *</option>
                </select>
                <span asp-validation-for="Input.CaliberId" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <input asp-for="Input.Serial" class="form-control floating_input" placeholder="Serial No.">
                <label asp-for="Input.Serial" class="floating_label" data-content="Serial No. *">
                    <span class="hidden--visually">Serial No.</span>
                </label>
                <span asp-validation-for="Input.Serial" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <input asp-for="Input.PurchaseDate" class="form-control floating_input" type="date">
                <label asp-for="Input.PurchaseDate" class="floating_label" data-content="Purchase Date *">
                    <span class="hidden--visually">Purchase Date</span>
                </label>
                <span asp-validation-for="Input.PurchaseDate" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <input asp-for="Input.Price" class="form-control floating_input" placeholder="Price">
                <label asp-for="Input.Price" class="floating_label" data-content="Price">
                    <span class="hidden--visually">Price</span>
                </label>
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <textarea asp-for="Input.Notes" class="form-control form-control-2" rows="5" placeholder="Notes"></textarea>
                <span asp-validation-for="Input.Notes" class="text-danger"></span>
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <label class="d-block mb-1">Image</label>
                <input asp-for="Input.Image" type="file" class="form-control-file">
            </div>

            <div class="col-sm-10 col-md-8 col-lg-7 mb-3">
                <label class="d-block mb-1">Document</label>
                <input asp-for="Input.Document" type="file" class="form-control-file">
            </div>
        </div>

        <div class="form-group row justify-content-center">
            <div class="col-sm-10 col-md-8 col-lg-7">
                <button type="submit" class="btn btn-primary btn-block w-100">Submit</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
