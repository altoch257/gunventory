@page
@model AccessoryDetailsModel
@{
    ViewData["Title"] = "Accessory Details";
}

<div class="container text-white">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center my-4">
            <h2>Accessory Details</h2>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <span class="float-left mr-3">
                <img src="@Model.Accessory.ImgURL" style="max-width: 9rem; max-height: 9rem;">
            </span>

            <span class="d-block">
                <div class="h3 d-block mb-2">@Model.Accessory.Model</div>
                <div>@Model.Accessory.Manufacturer</div>
                <div>For: @Model.Accessory.Firearm.Model</div>
            </span>
        </div>
    </div>

    <div class="row justify-content-center mt-3">
        <div class="col-md-8">
            <span class="float-left">
                <a class="btn btn-primary btn-sm text-light mr-2" asp-page="/EditAccessory" asp-route-id="@Model.Accessory.Id"><i class="mdi mdi-small mdi-square-edit-outline"></i></a>
            </span>
            <span class="float-right">
                <a class="btn btn-danger btn-sm text-light" asp-page="/DeleteAccessory" asp-route-id="@Model.Accessory.Id"><i class="mdi mdi-small mdi-trash-can-outline"></i></a>
            </span>
        </div>
    </div>

    <!-- Stats / Details -->
    <div class="row justify-content-center">
        <div class="col-md-8 text-center mt-5">
            <h2>Stats / Details</h2>
        </div>
    </div>

    <div class="row justify-content-center my-1">
        <div class="col-9 col-md-5 shaded-row bg-dark p-2 border-bottom border-secondary">
            Purchase Date:
        </div>
        <div class="col-3 col-md-3 shaded-row bg-dark p-2 border-bottom border-secondary">
            @Model.Accessory.PurchaseDate.ToString("yyyy-MM-dd")
        </div>
    </div>

    <div class="row justify-content-center my-1">
        <div class="col-9 col-md-5 shaded-row bg-dark p-2 border-bottom border-secondary">
            Purchase Price:
        </div>
        <div class="col-3 col-md-3 shaded-row bg-dark p-2 border-bottom border-secondary">
            @Model.Accessory.Price.ToString("C")
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Accessory.Details))
    {
        <div class="row justify-content-center my-1">
            <div class="col-12 col-md-2 shaded-row bg-dark p-2 border-bottom border-secondary">
                Details:
            </div>
            <div class="col-12 col-md-6 shaded-row bg-dark p-2 border-bottom border-secondary">
                @Model.Accessory.Details
            </div>
        </div>
    }
    <div class="mb-5"></div>
</div>
