@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>@ViewData["Title"] | Gunventory</title>
    <link rel="shortcut icon" href="~/img/favicon.ico">

    <!-- Links -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@mdi/font@6.9.96/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">

    <!-- Toaster -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;1,100;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400..700&family=Lato:ital,wght@0,100;0,300;0,400;0,700;1,100;1,300;1,400&display=swap" rel="stylesheet">
</head>
<body class="bg-dark text-white">

    <!-- Navigation -->
    <nav class="navbar bg-dark navbar-dark navbar-expand-lg border-bottom border-secondary">
        <div class="container">
            <a asp-page="/Index" class="navbar-brand"><img src="~/img/logo.png" alt="Logo" title="Logo" height="40px"></a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarResponsive">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarResponsive">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a asp-page="/Index" class="nav-link">Home</a></li>
                    <li class="nav-item"><a asp-page="/ManageInventory" class="nav-link">Add Inventory</a></li>
                    <div class="floatr">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
                                    @User.FindFirst("FirstName")?.Value
                                </a>
                                <div class="dropdown-menu dropdown-menu-right bg-dark">
                                    <a class="nav-link dropdown-item" href="#"><i class="mdi mdi-small mdi-account-circle-outline pr-2"></i>My Profile</a>
                                    <div class="dropdown-divider"></div>
                                    <form method="post" asp-page="/Logout" id="logoutForm">
                                        <button type="submit" class="nav-link dropdown-item w-100 text-left border-0 bg-transparent"><i class="mdi mdi-small mdi-logout pr-2"></i>Logout</button>
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Login">Login</a></li>
                        }
                    </div>
                </ul>
            </div>
        </div>
    </nav>
    <!-- End Navigation -->

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/js/jquery-3.5.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
